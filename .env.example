# Pulse 部署环境变量示例
# 复制为 .env 并填入真实值；.env 勿提交到仓库（已在 .dockerignore / .gitignore 忽略）
# 启动：docker compose up -d --build

# 【必填】用户 LLM Key 加密主密钥（AES-256-GCM, 32 字节 = 64 位 hex）
# 生成：./scripts/gen-key.sh
PULSE_ENCRYPTION_KEY=

# 【必填】JWT 签名密钥（HS256，需 ≥ 32 字节 / 64 位 hex）
# 生成：openssl rand -hex 32
# 注意：缺失或不足 32 字节应用将启动失败（fail-fast）
JWT_SECRET=

# 数据库 root 口令（必填，无默认弱口令）
MYSQL_ROOT_PASSWORD=

# 应用专用账号（最小权限）口令；db 初始化脚本据此创建 pulse_app 账号并授予 pulse.* 读写权限。
# 应用通过 PULSE_DB_USER / PULSE_DB_PASSWORD 连接，root 仅用于初始化，不交付应用。
# 注意：若 PULSE_DB_PASSWORD 为空，初始化将创建空口令账号，生产务必填写强口令。
PULSE_DB_PASSWORD=
# 可选，默认 pulse_app
PULSE_DB_USER=pulse_app

# 数据源（compose 内 mysql 服务；独立部署时改为实际地址）
DATASOURCE_URL=jdbc:mysql://db:3306/pulse?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai&createDatabaseIfNotExist=true
JWT_EXPIRATION=86400000

# 前端访问域名（CORS 白名单，逗号分隔）
CORS_ALLOWED_ORIGINS=http://localhost:8080

# AI 缺省 base-url / model（用户未显式填写时使用）
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# 是否启用 Swagger/OpenAPI 文档（生产务必 false）
SWAGGER_ENABLED=false

# 服务对外端口（映射到 nginx 443）
APP_PORT=8080

# 数据库 schema 初始化方式
#   never  = 由 MySQL 初始化卷在首次建库时一次性建表（生产推荐；保留 docker-compose 中 schema.sql 挂载）
#   always = 由应用在每次启动时自建表（幂等 CREATE TABLE IF NOT EXISTS，适合裸 java -jar 本地开发）
SQL_INIT_MODE=never

# 事务邮件（密码重置等）投递配置
# enabled=false 或未配置 SMTP 时，重置链接仅记服务端日志，不阻断启动与主流程
MAIL_ENABLED=false
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@pulse.local
# 重置邮件中拼接的绝对链接前缀（需可被用户点击访问前端）
MAIL_FRONTEND_BASE_URL=http://localhost:5173
